# ===== Configuration de deploiement JJBible =====
# Copie ce fichier en .env  ->  cp .env.example .env
# puis edite les valeurs (surtout DB_PASSWORD et JWT_SECRET).

# Port HTTP expose sur la machine hote (80 = http standard)
HTTP_PORT=80

# Base de donnees
DB_NAME=jjbible
DB_PASSWORD=change_moi_mot_de_passe_fort

# En PRODUCTION mets false (le schema ne doit pas etre modifie par l'app).
# Au TOUT PREMIER demarrage, laisse true le temps que les tables se creent,
# seed les ceintures, puis repasse a false et redeploie.
DB_SYNCHRONIZE=true

# Secret JWT : genere une vraie valeur :  openssl rand -hex 32
JWT_SECRET=change_moi_chaine_aleatoire_longue
JWT_EXPIRES_IN=7d
